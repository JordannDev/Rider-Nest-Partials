<idea-plugin require-restart="true">
  <id>com.jordanmolenaar.partialnesting</id>
  <name>Partial Class Nesting</name>
  <vendor>Jordan Molenaar</vendor>
  <depends>com.intellij.modules.rider</depends>
  <dependencies>
    <module name="intellij.rider.rdclient.dotnet" />
  </dependencies>
  <description><![CDATA[
    <p>Nests C# files that declare the same partial class in Rider's Solution Explorer.</p>
    <p>Uses C# type information and leaves project files unchanged.</p>
  ]]></description>
  <extensions defaultExtensionNs="com.intellij">
    <solutionExplorerCustomization implementation="com.jordanmolenaar.rider.partialnesting.explorer.PartialNestingCustomization" />
    <projectConfigurable parentId="appearance" id="partialClassNesting" displayName="Partial Class Nesting"
                         instance="com.jordanmolenaar.rider.partialnesting.settings.PartialNestingConfigurable" />
  </extensions>
</idea-plugin>
